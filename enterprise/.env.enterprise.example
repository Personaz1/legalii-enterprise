# LEGALII Enterprise environment
LEGALII_ENV=production
LEGALII_BIND=0.0.0.0
LEGALII_PORT=8777
LEGALII_DATA_DIR=./data
LEGALII_LOG_DIR=./logs

# Security defaults (hardened)
LEGALII_REQUIRE_AUTH=true
LEGALII_STRICT_MODE=true
LEGALII_ENABLE_AUDIT_LOG=true
LEGALII_CLOUD_MODELS_ENABLED=false
LEGALII_CORS_ORIGINS=http://127.0.0.1:8777,http://localhost:8777

# REQUIRED: set at deploy time
LEGALII_API_KEY=change-me-to-strong-random-secret
LEGALII_TOKEN_SECRET=change-me-to-separate-strong-random-secret
LEGALII_TOKEN_TTL_SECONDS=28800

# Optional: multi-user API key registry (instead of single key)
# LEGALII_API_KEYS_JSON={"admin-key":{"user":"admin","role":"admin"}}

# Local model mode (future integration)
LEGALII_LOCAL_LLM_PROVIDER=ollama
LEGALII_LOCAL_LLM_ENDPOINT=http://ollama:11434
LEGALII_LOCAL_LLM_MODEL=llama3.1:8b
